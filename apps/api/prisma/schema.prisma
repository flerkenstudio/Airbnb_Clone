generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id               String   @id @default(uuid())
  title            String
  propertyType     String
  location         String
  guests           Int
  bedrooms         Int
  beds             Int
  bathrooms        Int
  rating           Float
  reviewsCount     Int
  isGuestFavourite Boolean
  pricePerNight    Float
  cleaningFee      Float
  serviceFee       Float
  description      String
  
  hostId           String
  host             Host     @relation(fields: [hostId], references: [id])

  highlights       Highlight[]
  amenities        Amenity[]
  images           Image[]
}

model Host {
  id           String    @id @default(uuid())
  name         String
  avatar       String
  isSuperhost  Boolean
  yearsHosting Int
  description  String
  listings     Listing[]
}

model Highlight {
  id          String  @id @default(uuid())
  icon        String
  title       String
  description String
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id])
}

model Amenity {
  id        String  @id @default(uuid())
  category  String
  icon      String
  name      String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
}

model Image {
  id        String  @id @default(uuid())
  url       String
  category  String
  order     Int
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
}
